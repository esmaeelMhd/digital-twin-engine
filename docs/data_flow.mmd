flowchart TB
    %% Digital Twin Engine data flow
    %% Solid edges = implemented first-class path
    %% Dashed edges = thin-slice / partial / future-supported path

    subgraph OFFLINE[Offline Capability Building]
        A1[System YAMLs\nregistered process specs]
        A2[Registry + schema resolution\nSystemSpec / ProcessUnitSpec]
        A3[Synthetic generation\nGenericDataGenerator / simulator rollouts]
        A4[Single-system datasets\nTrajectoryDataset]
        A5[Mixed-system datasets\nMultiSystemTrajectoryDataset]
        A6[Physics + law metadata\nPhysicsLoss registry / UnitLawBundle]

        B1[Single-system training\nDigitalTwin + Trainer]
        B2[Universal training\nUniversalDigitalTwin + UniversalTrainer]

        B3[Unit checkpoints\nsingle-system artifacts]
        B4[Shared checkpoints\nuniversal artifacts]

        C1[Flowsheet specs\nFlowsheetSpec / examples]
        C2[Synthetic flowsheet dataset\nFlowsheetTrajectoryDataset]
        C3[Flowsheet experiments\nFlowsheetModel + FlowsheetTrainer]
        C4[Thin-slice flowsheet artifacts]

        A1 --> A2
        A2 --> A3
        A3 --> A4
        A3 --> A5
        A2 --> A5
        A2 --> A6
        A6 --> B1
        A6 --> B2
        A4 --> B1
        A5 --> B2
        B1 --> B3
        B2 --> B4

        A1 -. optional flowsheet spec authoring .-> C1
        C1 -. synthetic graph generation .-> C2
        C2 -. smoke / thin-slice training .-> C3
        C3 -. experimental artifacts .-> C4
    end

    subgraph DEPLOY[Customer Deployment And Validation]
        D1[Customer process description\nhistorian uploads / metadata]
        D2[Onboarding preview + schema mapping\ncolumn maps / template selection]
        D3[Processed customer dataset\nphysical-unit trajectories]
        D4[Template / family matching\nselect candidate unit family]

        E1[Unit adaptation path\nUnitCalibrator / lightweight adapters\nnormalization + optional param calibration]
        E2[Validation\nrollout fit / forecast fit / reports]
        E3[Deployed twin runtime\nFastAPI / demo runtime / planning workspace]

        F1[State correction + monitoring\nStateCorrectionHook / online hooks]
        F2[MPC-facing interface\nProcessMPCInterface]
        F3[RL evaluation wrapper\nProcessControlEnv]

        G1[Customer flowsheet description]
        G2[Assemble flowsheet graph]
        G3[Future supported flowsheet adaptation path]

        D1 --> D2
        D2 --> D3
        D2 --> D4
        B4 --> E1
        D3 --> E1
        D4 --> E1
        E1 --> E2
        E2 --> E3
        E3 --> F1
        F1 --> F2
        F1 --> F3

        D1 -. if customer provides flowsheet structure .-> G1
        G1 -. graph assembly .-> G2
        G2 -. not first-class yet .-> G3
    end

    subgraph TARGET[Target-State Movement]
        T1[Broader mechanistic + synthetic + real corpora]
        T2[Unit-family and universal checkpoint library]
        T3[Flowsheet assembly from pretrained unit families]
        T4[Law-grounded and graph-aware adaptation]
        T5[Validated twin + control surfaces]
    end

    B3 -. contributes to future library .-> T2
    B4 -. contributes to future library .-> T2
    C4 -. informs future flowsheet path .-> T3
    E3 -. runtime basis .-> T5
    F2 -. deployable control surface .-> T5
    F3 -. evaluation / training surface .-> T5
    T1 -. expands offline capability building .-> T2
    T2 -. enables richer deployment assembly .-> T3
    T3 -. combine with customer data + laws .-> T4
    T4 -. production candidate .-> T5

    classDef first fill:#e8f5e9,stroke:#2e7d32,stroke-width:1px,color:#1b5e20;
    classDef thin fill:#fff8e1,stroke:#f9a825,stroke-width:1px,color:#8d6e00;
    classDef target fill:#e3f2fd,stroke:#1565c0,stroke-width:1px,color:#0d47a1;

    class A1,A2,A3,A4,A5,A6,B1,B2,B3,B4,D1,D2,D3,D4,E1,E2,E3,F1,F2,F3 first;
    class C1,C2,C3,C4,G1,G2,G3 thin;
    class T1,T2,T3,T4,T5 target;
